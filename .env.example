# Telegram Bot Token（@BotFather 获取）
TELEGRAM_BOT_TOKEN=123456:ABCDEF...

# 可选：服务器默认 TronGrid API Key（用户未 /setkey 时使用）
# TRONGRID_API_KEY=

# 数据目录（Docker 内默认 /app/data，一般不用改）
DATA_DIR=./data

# 默认 USDT/CNY 汇率
DEFAULT_USDT_CNY_RATE=7.20

# 并发查询地址数
ADDRESS_CONCURRENCY=3

# 请求超时与重试
REQUEST_TIMEOUT_MS=15000
MAX_REQUEST_RETRIES=2
