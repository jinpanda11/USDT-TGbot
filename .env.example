# Telegram Bot Token（@BotFather 获取）
TELEGRAM_BOT_TOKEN=123456:ABCDEF...

# 可选：服务器默认 TronGrid API Key（用户未 /setkey 时使用）
# 不配置也可以查询（走公共接口，有限流）；被限流时提示用户去 trongrid.io 注册免费 Key
# TRONGRID_API_KEY=

# 数据目录（Docker 内默认 /app/data，一般不用改）
DATA_DIR=./data

# 默认 USDT/CNY 汇率
DEFAULT_USDT_CNY_RATE=7.20

# 并发查询地址数（1-20）
ADDRESS_CONCURRENCY=3

# 请求超时与重试
REQUEST_TIMEOUT_MS=15000
MAX_REQUEST_RETRIES=2

# ---------- 访问控制 ----------
# 允许使用 Bot 的 Telegram 用户 ID（逗号分隔）。留空 = 不限制任何人
# ALLOWED_TELEGRAM_USER_IDS=123456789,987654321
# 广告管理员 ID（逗号分隔，仅这些 ID 可执行 /ad_new /ad_list 等管理命令）
# ADMIN_TELEGRAM_USER_IDS=123456789
# 敏感操作（查询/导出/设置/地址管理）仅允许私聊（true/false）
REQUIRE_PRIVATE_CHAT=true

# ---------- 查询限流与资源上限 ----------
# 全局同时进行的查询数（1-20）
GLOBAL_QUERY_CONCURRENCY=2
# 每用户每分钟最多查询次数（0 = 不限制）
MAX_QUERIES_PER_USER_PER_MIN=5
# 相同查询结果内存缓存毫秒数（0 = 关闭）
QUERY_CACHE_TTL_MS=60000
# 单个地址最多翻页数（TronGrid 每页 200 条）
MAX_PAGES_PER_ADDRESS=100
# 单次查询最大记录数
MAX_RECORDS_PER_QUERY=100000
# 单次查询总超时（毫秒）
QUERY_TOTAL_TIMEOUT_MS=300000

# ---------- 会话与日志 ----------
# 会话（添加地址/设置/监听）有效期，毫秒
SESSION_TTL_MS=1800000
# 地址监听轮询间隔（毫秒，10 秒到 1 小时）
WATCH_POLL_INTERVAL_MS=60000
# 日志级别：debug/info/warn/error
LOG_LEVEL=info
# 可选健康检查端口（0 = 关闭）
HEALTH_PORT=0

# ---------- 广告（阶段 A：查询结果赞助位） ----------
# 总开关的「初始默认值」（默认关闭）。运行中可在 TG 的 /ad_list 顶部按钮一键开/关，
# 切换后的状态持久化在 ads.json 的 enabled 字段，立即生效无需重启。
ADS_ENABLED=false
# 广告配置文件（默认 <DATA_DIR>/ads.json，格式参考 ads.example.json）
# ADS_FILE=./data/ads.json
# 曝光/点击事件日志（JSONL，默认 <DATA_DIR>/ad-events.jsonl）
# AD_EVENTS_FILE=./data/ad-events.jsonl
# 展示比例 0-1：1=每次查询都展示；0.1=约 10% 查询展示（灰度）
AD_SHOW_RATIO=1
